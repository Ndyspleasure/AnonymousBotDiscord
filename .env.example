# Token bot Anonymous (Discord Developer Portal -> Bot)
DISCORD_TOKEN=
# Application ID bot Anonymous
CLIENT_ID=
# (Opsional) webhook channel log: menerima transkrip SETIAP chat yang berakhir (berkas .txt).
LOG_WEBHOOK_URL=
# (Opsional) webhook channel laporan (/report dan tombol Report). Kosong = memakai LOG_WEBHOOK_URL.
REPORT_WEBHOOK_URL=
# (Opsional) ID user Discord pemilik/moderator, pisahkan koma
OWNER_IDS=

# (Opsional, disarankan) PostgreSQL agar chat tidak terputus saat bot restart/crash.
# Aiven: salin "Service URI" (postgres://...). Kosong = hanya memori.
DATABASE_URL=
# (Opsional) isi ca.pem Aiven (ganti baris baru dengan \n) untuk memverifikasi sertifikat server.
DATABASE_CA=
